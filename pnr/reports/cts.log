{filtro_pdm.dlib:filtro_pdm/place.design}
# ------------------------------------------------------------
# 2. Ajustes de otimizacao
# ------------------------------------------------------------
# Transicao maxima (tambem definida no SDC fisico; reaplicada
# aqui porque o bloco foi criado antes dessa restricao).
set_max_transition 0.50 [current_design]
Using libraries: filtro_pdm.dlib saed32rvt_base_frame_timing
Warning: In library filtro_pdm.dlib, no block views exist for block filtro_pdm. (LNK-064)
Visiting block filtro_pdm.dlib:filtro_pdm/place.design
Design 'filtro_pdm' was successfully linked.
1
# Camadas de roteamento de sinais e do clock: M2-M8
# M1: somente pinos e rails das celulas. Trechos curtos de M1
#     roteados com 0,05 um violam a regra M1.W.2.1 do DRC
#     (largura minima de 0,06 um junto a M1 largo).
# M9: anel de alimentacao; MRDL: redistribuicao para pads.
set_ignored_layers -min_routing_layer M2 -max_routing_layer M8
1
# Modo "hard": a camada minima vale tambem para o acesso aos
# pinos. No modo padrao (allow_pin_connection) o roteador ainda
# usa ate ~5 um de M1 para chegar aos pinos, o que deixou 10
# violacoes M1.W.2.1 no DRC. Os pinos em M1 sao acessados por
# vias VIA12 a partir de M2.
foreach {opcao valor} {
    route.common.global_min_layer_mode hard
    route.common.net_min_layer_mode    hard
} {
    if {[catch {set_app_options -name $opcao -value $valor} msg]} {
        puts "Aviso: opcao $opcao nao aplicada ($msg)"
    } else {
        puts "Opcao $opcao = $valor"
    }
}
Opcao route.common.global_min_layer_mode = hard
Opcao route.common.net_min_layer_mode = hard
# Permite o uso das celulas TIE (TIEH/TIEL) caso a otimizacao
# gere redes constantes (aviso OPT-200 no placement).
set_lib_cell_purpose -include optimization [get_lib_cells */TIE*]
Information: The design specific attribute override for lib_cell 'saed32rvt_base_frame_timing:TIEH_RVT.timing' is set in the current block 'filtro_pdm', because the actual library setting may not be overwritten. (ATTR-12)
Information: The design specific attribute override for lib_cell 'saed32rvt_base_frame_timing:TIEL_RVT.timing' is set in the current block 'filtro_pdm', because the actual library setting may not be overwritten. (ATTR-12)
1
# ------------------------------------------------------------
# Margem de hold para o corner rapido
#
# O P&R otimiza somente o corner tipico (tt0p85v25c). No
# PrimeTime, o corner rapido (ff0p95vn40c) mostrou ~1.330
# caminhos de scan (Q -> SI) com hold ate -0,06 ns. Inserir
# as celulas de atraso por ECO depois do roteamento falhou
# (1.353 celulas sem espaco livre, 1.245 sobreposicoes).
# Solucao: durante o CTS e o roteamento, a incerteza de hold
# e aumentada de 0,10 para 0,20 ns, de modo que o proprio
# otimizador insira os atrasos com folga para o corner ff.
# O finish.tcl restaura o valor da especificacao (0,10 ns)
# antes dos relatorios e da exportacao do SDC.
# ------------------------------------------------------------
set HOLD_UNCERTAINTY_OTIMIZACAO 0.20
0.20
set_clock_uncertainty -hold $HOLD_UNCERTAINTY_OTIMIZACAO [get_clocks clk]
1
