report_power > pnr/reports/power_saif/power.rpt
# Divisao por bloco (CIC x FIR)
if {[catch {report_power -hierarchy \
        > pnr/reports/power_saif/power_hier.rpt} msg]} {
    puts "Aviso: relatorio hierarquico nao gerado ($msg)"
}
