# ============================================================
# route.tcl
# Roteamento global, track assignment e detalhado
# Projeto: Filtro PDM CIC + FIR
# Ferramenta: Synopsys Fusion Compiler
# Tecnologia: SAED32 RVT
#
# Entrada:  filtro_pdm/cts
# Saida:    filtro_pdm/route
#
# ATENCAO:
# Versao candidata, ainda nao validada no Fusion Compiler.
# ============================================================
file mkdir pnr/reports/route
# ------------------------------------------------------------
# 1. Abrir o checkpoint do CTS
# ------------------------------------------------------------
open_lib pnr/work/filtro_pdm.dlib
Information: Loading library file '/home/raissa.crispim/tcc_filtro/pnr/work/filtro_pdm.dlib' (FILE-007)
Information: Loading library file '/Tools/PDK/SAED32/EDK_Digital/lib/stdcell_rvt/ndm/saed32rvt_base_frame_timing.ndm' (FILE-007)
{filtro_pdm.dlib}
open_block filtro_pdm/cts
Information: User units loaded from library 'saed32rvt_base_frame_timing' (LNK-040)
Opening block 'filtro_pdm.dlib:filtro_pdm/cts.design' in edit mode
{filtro_pdm.dlib:filtro_pdm/cts.design}
# ------------------------------------------------------------
# 2. Camadas de roteamento de sinais
#
# Sinais em M2-M8.
# M1 fica restrita aos pinos e rails das celulas: trechos
# curtos de M1 roteados com 0,05 um violaram a regra M1.W.2.1
# do DRC (largura minima de 0,06 um junto a M1 largo).
# M9 e reservada ao anel de alimentacao (vertical) e MRDL e a
# camada de redistribuicao para pads (largura minima de 2 um).
# ------------------------------------------------------------
set_ignored_layers \
    -min_routing_layer M2 \
    -max_routing_layer M8
Using libraries: filtro_pdm.dlib saed32rvt_base_frame_timing
Warning: In library filtro_pdm.dlib, no block views exist for block filtro_pdm. (LNK-064)
Visiting block filtro_pdm.dlib:filtro_pdm/cts.design
Design 'filtro_pdm' was successfully linked.
