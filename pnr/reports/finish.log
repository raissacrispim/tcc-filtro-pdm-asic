# ------------------------------------------------------------
# 1b. Correcao das violacoes residuais de capacitancia maxima
#
# Apos o route_opt restaram ~11 redes ate 0,10 fF acima do
# limite da biblioteca (8 ou 16 fF). A correcao e um ECO:
# a celula que dirige cada rede violada e trocada pela versao
# de maior drive (ex.: INVX1 -> INVX2), que admite maior
# carga. Em seguida a posicao e legalizada e as ligacoes sao
# refeitas com route_eco. Repete (junto com o ECO de hold, 1c),
# pois a celula
# maior aumenta um pouco a carga da rede anterior.
# ------------------------------------------------------------
# Mesmas restricoes de roteamento de route.tcl (M2-M8, sem M1)
set_ignored_layers -min_routing_layer M2 -max_routing_layer M8
1
foreach {opcao valor} {
    route.common.global_min_layer_mode hard
    route.common.net_min_layer_mode    hard
} {
    catch {set_app_options -name $opcao -value $valor}
}
# Proximo tamanho existente da celula (INVX1_RVT -> INVX2_RVT)
proc maior_drive {ref} {
    if {![regexp {^(.*X)([0-9]+)(_RVT)$} $ref -> base n suf]} {
        return ""
    }
    foreach m {1 2 4 8 16 32} {
        if {$m <= $n} { continue }
        set lc [get_lib_cells -quiet */${base}${m}${suf}]
        if {[sizeof_collection $lc] > 0} { return $lc }
    }
    return ""
}
# Posiciona as celulas alteradas/inseridas e refaz as ligacoes
proc posiciona_e_roteia_eco {} {
    if {[catch {place_eco_cells -eco_changed_cells -legalize_only} msg]} {
        puts "Aviso: place_eco_cells ($msg)"
        if {[catch {legalize_placement -incremental} msg]} {
            puts "Aviso: legalize_placement -incremental ($msg)"
            legalize_placement
        }
    }
    route_eco
    connect_pg_net -automatic
}
# Pinos que dirigem redes com capacitancia maxima violada
proc pinos_max_cap {arquivo} {
    report_constraints -all_violators -max_capacitance > $arquivo
    set pinos {}
    set f [open $arquivo r]
    while {[gets $f linha] >= 0} {
        if {[regexp {PIN\s*:\s*(\S+)} $linha -> pino]} {
            lappend pinos $pino
        }
    }
    close $f
    return [lsort -unique $pinos]
}
# Uma rodada do ECO de capacitancia maxima. Retorna o numero
# de celulas alteradas (0: nada a corrigir ou nada corrigivel).
proc eco_max_cap {tag} {
    set pinos [pinos_max_cap pnr/reports/finish/max_cap_antes_eco_$tag.rpt]
    puts "ECO max cap, rodada $tag: [llength $pinos] violacoes"
    if {[llength $pinos] == 0} { return 0 }

    set trocadas {}
    foreach pino $pinos {
        set celula [get_cells -quiet -of_objects [get_pins -quiet $pino]]
        if {[sizeof_collection $celula] == 0} { continue }
        set ref  [get_attribute $celula ref_name]
        # Celulas da arvore de clock (ZCTS*, CTS*) ou fixas nao
        # sao alteradas: o legalizador nao as move, e a troca
        # por uma versao maior sobrepos uma celula vizinha
        # (curto em M1 que reprovou DRC/LVS)
        set status ""
        catch {set status [get_attribute $celula physical_status]}
        if {[string match "*CTS*" [get_object_name $celula]] ||
            $status eq "fixed" || $status eq "application_fixed"} {
            puts "  [get_object_name $celula] ($ref): celula de clock/fixa, mantida"
            continue
        }
        # Flip-flops nao sao trocados por versoes maiores. Com a
        # troca SDFFX1 -> SDFFX2 (celula mais larga), a
        # legalizacao deslocou flip-flops e 5 redes da arvore de
        # clock (ZCTSNET) passaram do limite (ate 72 fF para 64
        # fF); o pino CLK tem a mesma capacitancia nas duas
        # versoes (0,626 fF), o efeito e de fio. Recebem um
        # buffer na saida, como as celulas ja no maior tamanho.
        set sequencial 0
        if {[catch {set sequencial [get_attribute $celula is_sequential]}]} {
            set sequencial [string match "*DFF*" $ref]
        }
        set nova ""
        if {$sequencial ne "true" && $sequencial ne "1"} {
            set nova [maior_drive $ref]
        }
        if {$nova ne ""} {
            size_cell $celula $nova
            puts "  [get_object_name $celula]: $ref -> [get_object_name $nova]"
            lappend trocadas [get_object_name $celula]
            continue
        }
        # Flip-flop ou celula ja no maior tamanho (ex.: FADDX2):
        # um buffer isola a rede e a celula passa a dirigir so o
        # buffer. O buffer e colocado junto da celula: a carga
        # destas redes e quase toda de fio (ex.: delay_49__4_ com
        # 16 fF ligada so a entrada de um NBUFFX4, 0,65 fF); com o
        # buffer longe, o fio ate ele mantinha a violacao.
        set rede [get_nets -quiet -of_objects [get_pins $pino]]
        if {[catch {set buf [add_buffer -lib_cell \
                [get_lib_cells */NBUFFX4_RVT] $rede]} msg]} {
            puts "  $pino ($ref): buffer nao inserido ($msg)"
        } else {
            set bb [get_attribute $celula boundary_bbox]
            if {[catch {set_cell_location -coordinates [lindex $bb 0] \
                    [get_cells $buf]} msg]} {
                puts "  [get_object_name $rede]: buffer inserido, sem mover ($msg)"
            } else {
                puts "  [get_object_name $rede]: buffer NBUFFX4 junto de [get_object_name $celula]"
            }
            # O fio antigo (do driver ate todas as cargas) continua
            # preso a rede do driver depois do add_buffer, e o
            # route_eco nao o remove: a rede seguia com ~16 fF de
            # fio e a violacao voltava a cada rodada. As rotas das
            # duas redes do buffer sao apagadas e refeitas no
            # route_eco.
            set redes_buf [get_nets -quiet -of_objects \
                [get_pins -quiet -of_objects [get_cells $buf] \
                    -filter "direction==in || direction==out"]]
            if {[catch {remove_routes -nets $redes_buf -detail_route} msg] &&
                [catch {remove_routes -nets $redes_buf} msg]} {
                puts "  [get_object_name $rede]: rotas antigas mantidas ($msg)"
            }
            lappend trocadas [get_object_name $rede]
        }
    }
    if {[llength $trocadas] > 0} { posiciona_e_roteia_eco }
    return [llength $trocadas]
}
# ------------------------------------------------------------
# 1c. ECO de hold residual
#
# Com os cenarios MCMM, o clock_opt e o route_opt corrigiram as
# entradas e os caminhos funcionais, mas deixaram ~59 caminhos
# de deslocamento da cadeia de scan no cenario scan_ff (Q/QN
# ligado direto ao SI do flip-flop seguinte, sem logica, ate
# -0,04 ns). O route_opt nao os corrigiu em duas passadas, sem
# mensagem de impedimento.
#
# Correcao: um buffer NBUFFX2 e inserido so no pino de entrada
# violado, atrasando apenas aquele ramo da rede. Se um buffer
# nao bastar, a rodada seguinte insere outro em serie no mesmo
# pino. A primeira versao usava DELLN1X2, cuja capacitancia de
# entrada sobrecarregou as saidas QN dos flip-flops (ate 20,6 fF
# para limite de 8 fF). O custo em setup e desprezivel (folga
# de shift ~187 ns).
# ------------------------------------------------------------
proc pinos_hold_violados {} {
    set pinos {}
    foreach_in_collection t [get_timing_paths -delay_type min \
            -scenarios [get_scenarios *] -max_paths 10000 \
            -slack_lesser_than 0.0] {
        set ep [get_attribute $t endpoint]
        if {[get_attribute $ep object_class] ne "pin"} { continue }
        lappend pinos [get_object_name $ep]
    }
    return [lsort -unique $pinos]
}
# Uma rodada do ECO de hold. Retorna o numero de buffers inseridos.
proc eco_hold {tag} {
    set pinos [pinos_hold_violados]
    puts "ECO hold, rodada $tag: [llength $pinos] pinos com hold violado"
    if {[llength $pinos] == 0} { return 0 }
    set f [open pnr/reports/finish/hold_eco_$tag.txt w]
    foreach p $pinos { puts $f $p }
    close $f
    set inseridos 0
    foreach p $pinos {
        if {[catch {add_buffer -lib_cell [get_lib_cells */NBUFFX2_RVT] \
                [get_pins $p]} msg]} {
            puts "  $p: buffer de hold nao inserido ($msg)"
        } else {
            incr inseridos
        }
    }
    puts "  $inseridos buffers NBUFFX2 de hold inseridos"
    if {$inseridos > 0} { posiciona_e_roteia_eco }
    return $inseridos
}
# Hold primeiro (insere cargas), depois capacitancia maxima (pode
# trocar celulas e alterar atrasos); repete ate os dois zerarem.
for {set ciclo 1} {$ciclo <= 5} {incr ciclo} {
    set n_hold [eco_hold $ciclo]
    set n_cap  [eco_max_cap $ciclo]
    if {$n_hold == 0 && $n_cap == 0} { break }
}
