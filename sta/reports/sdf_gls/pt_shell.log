set OPCOES [list -version 3.0 -context verilog -significant_digits 3                  -include {SETUPHOLD RECREM} -input_port_nets]
-version 3.0 -context verilog -significant_digits 3 -include {SETUPHOLD RECREM} -input_port_nets
if {[info exists env(SDF_SAIDAS)] && $env(SDF_SAIDAS) eq "1"} {
    lappend OPCOES -output_port_nets
}
write_sdf {*}$OPCOES $SDF
