# ------------------------------------------------------------
# 3. Relatorios
# ------------------------------------------------------------
report_global_timing > $REP/global_timing.rpt
report_timing -delay_type max -max_paths 10     -significant_digits 3 > $REP/timing_max.rpt
report_timing -delay_type min -max_paths 10     -significant_digits 3 > $REP/timing_min.rpt
report_constraint -all_violators > $REP/violadores.rpt
report_clock_timing -type skew > $REP/clock_skew.rpt
# Resumo no terminal
