(DELAYFILE
(SDFVERSION "OVI 2.1")
(DESIGN "mini")
(DIVIDER /)
(TIMESCALE 1ns)
(CELL (CELLTYPE "NBUFFX2_RVT") (INSTANCE u0)
  (DELAY (ABSOLUTE (IOPATH A Y (1.000::1.000)(1.000::1.000)))))
(CELL (CELLTYPE "NBUFFX2_RVT") (INSTANCE u1)
  (DELAY (ABSOLUTE (IOPATH A Y (2.000::2.000)(2.000::2.000)))))
(CELL (CELLTYPE "NBUFFX2_RVT") (INSTANCE u2)
  (DELAY (ABSOLUTE (IOPATH A Y (3.000::3.000)(3.000::3.000)))))
(CELL (CELLTYPE "mini") (INSTANCE)
  (DELAY (ABSOLUTE
    (INTERCONNECT u0/Y y[0] (0.500::0.500))
    (INTERCONNECT u1/Y y[1] (0.500::0.500))
    (INTERCONNECT u2/Y z (0.500::0.500)))))
)
