# ------------------------------------------------------------
# 4. Exportacao dos vetores e do testbench de simulacao
# ------------------------------------------------------------
write_patterns atpg/output/filtro_pdm_stuck.stil \
    -format stil -replace
 Patterns written reference 169 V statements, generating 74705 test cycles
 End writing file 'filtro_pdm_stuck.stil' with 55 patterns, File_size = 227746, CPU_time = 0.0 sec.
write_testbench \
    -input atpg/output/filtro_pdm_stuck.stil \
    -output atpg/output/filtro_pdm_stuck_tb \
    -replace
