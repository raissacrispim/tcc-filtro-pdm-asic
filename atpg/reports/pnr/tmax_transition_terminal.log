# ------------------------------------------------------------
# 4. Exportacao dos vetores
# ------------------------------------------------------------
write_patterns $OUT/filtro_pdm_transition.stil \
    -format stil -replace
 Patterns written reference 827 V statements, generating 221773 test cycles
 End writing file 'filtro_pdm_transition.stil' with 165 patterns, File_size = 561083, CPU_time = 0.0 sec.
# Testbench Verilog para a simulacao dos padroes
# (sim/scripts/sim_atpg.sh <etapa> transition)
write_testbench \
    -input $OUT/filtro_pdm_transition.stil \
    -output $OUT/filtro_pdm_transition_tb \
    -replace
 Executing 'stil2verilog'...
puts "ATPG transition: script executado ate o final."
ATPG transition: script executado ate o final.
puts "Cobertura em $REP/transition_summary.rpt"
Cobertura em atpg/reports/pnr/transition_summary.rpt
exit
