# ------------------------------------------------------------
# 4. Exportacao dos vetores e do testbench de simulacao
# ------------------------------------------------------------
write_patterns $OUT/filtro_pdm_stuck.stil \
    -format stil -replace
 Patterns written reference 280 V statements, generating 124063 test cycles
 End writing file 'filtro_pdm_stuck.stil' with 92 patterns, File_size = 332715, CPU_time = 0.0 sec.
write_testbench \
    -input $OUT/filtro_pdm_stuck.stil \
    -output $OUT/filtro_pdm_stuck_tb \
    -replace
